    "@tanstack/react-query": "^5.51.0",
    "expo": "~51.0.0",
    "expo-apple-authentication": "~6.4.0",
    "expo-auth-session": "~5.5.0",
    "expo-camera": "~15.0.0",
    "expo-crypto": "~13.0.0",
    "expo-file-system": "~17.0.0",
    "expo-image-manipulator": "~12.0.0",
