# Copy to .env (gitignored) and fill in real values.

# --- Local Supabase (from `supabase start` output) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- For the mobile app (Expo public env vars) ---
# These are bundled into the app — only use the anon key here, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Apple Sign-In (configure on the Supabase dashboard for hosted env) ---
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Google Sign-In ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
