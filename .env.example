# Copy to .env (gitignored) and fill in real values.

# --- Local Supabase (from `supabase start` output) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- For the mobile app (Expo public env vars) ---
# These are bundled into the app — only use the anon key here, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Apple Sign-In (configure on the Supabase dashboard for hosted env) ---
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Google Sign-In ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Phase 2 web portal (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY is shared with the section above.

# MedNecessity Partner API (sandbox first; live key at go-live, via secrets mgmt).
# Leave the key EMPTY for simulated mode (no BAA yet — fake data only).
MEDNECESSITY_API_URL=https://sandbox.mednecessity.ai/api/v1
MEDNECESSITY_API_KEY=

# Slack incoming webhook for status-transition notifications (optional).
SLACK_WEBHOOK_URL=
