{
  "name": "agile-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Agile wound-care platform — mobile app + Supabase backend + (Phase 2) Next.js portal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev:mobile": "npm start --workspace=@agile/mobile",
    "build:mobile:ios": "npm run eas:build:ios --workspace=@agile/mobile",
    "build:mobile:android": "npm run eas:build:android --workspace=@agile/mobile",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/supabase-client/src/database.types.ts",
    "supabase:lint": "supabase db lint",
    "migrate:reps": "tsx --env-file=.env scripts/migrate/import-reps.ts",
    "migrate:providers": "tsx --env-file=.env scripts/migrate/import-providers.ts",
    "migrate:assignments": "tsx --env-file=.env scripts/migrate/import-rep-provider-assignments.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@agile/web",
    "build:web": "npm run build --workspace=@agile/web",
    "postinstall": "node scripts/ensure-web-styled-jsx.cjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "xlsx": "^0.18.5"
  }
}
